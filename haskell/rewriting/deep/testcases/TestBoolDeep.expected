{-# LANGUAGE NoImplicitPrelude #-}{-# LANGUAGE NoImplicitPrelude #-}

module TestBoolDeep where
import SPL
import VPrelude
import Data.List -- TODO: without a dummy import, indentation goes wrong

data I_False = I_False

data I_True = I_True
data VBool = VBool_PoS { f_False :: SumOption I_False, f_True :: SumOption I_True }

instance VClass VBool where nil = VBool_PoS nil nil
                            comb a b = VBool_PoS (comb (f_False a) (f_False b)) (comb (f_True a) (f_True b))
instance VClass I_False where nil = I_False
                              comb I_False I_False = I_False

instance VClass I_True where nil = I_True
                             comb I_True I_True = I_True
consI_False x r = r { f_False = x }

consI_True x r = r { f_True = x } 
not :: VBool -> VBool 
not x  = match [(\(Present (I_False, pc)) r -> (consI_True (Present (I_True, allConfigs)) nil)) (f_False (x)), (\(Present (I_True, pc)) r -> (consI_False (Present (I_False, allConfigs)) nil)) (f_True (x))] 
ite :: VClass a => VBool -> a -> a -> a 
ite c x y  = match [(\(Present (I_True, pc)) r -> x) (f_True (c)), (\(Present (I_False, pc)) r -> y) (f_False (c))] 
(&&) :: VBool -> VBool -> VBool 
x && y  = ite x y (consI_False (Present (I_False, allConfigs)) nil) 
(||) :: VBool -> VBool -> VBool 
x || y  = ite x (consI_True (Present (I_True, allConfigs)) nil) y

